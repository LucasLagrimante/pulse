{
  "name": "pulse-windows",
  "private": true,
  "version": "1.2.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:native": "bash scripts/build-native.sh",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "tsc --noEmit && eslint src && vitest run && vite build",
    "tauri": "tauri",
    "tauri:build": "bash scripts/build-native.sh",
    "tauri:build:install": "bash scripts/build-native.sh --install",
    "lp:dev": "vite landing --config landing/vite.config.js",
    "lp:build": "vite build landing --config landing/vite.config.js",
    "lp:preview": "vite preview landing --config landing/vite.config.js",
    "lp:check": "node landing/scripts/check-seo.mjs --dir=landing/dist",
    "lp:sync": "node scripts/sync-landing.mjs",
    "lp:sync:release": "node scripts/sync-landing.mjs --from-release",
    "release:publish": "node scripts/publish-release.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-opener": "2.5.5",
    "lucide-react": "^1.46.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "2.11.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^26.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "@tauri-apps/cli-win32-x64-msvc": "2.11.5"
  }
}
