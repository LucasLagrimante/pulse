{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["deb", "appimage", "rpm"],
    "category": "Utility",
    "shortDescription": "Observabilidade local do sistema",
    "longDescription": "Pulse reúne monitor de processos, desempenho, análise de disco, inicialização, serviços e desinstalação em um painel local, sem telemetria.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "section": "utils"
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "libayatana-appindicator-gtk3"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
